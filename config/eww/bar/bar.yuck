(defwidget bar []
	(centerbox :orientation "h"
		(left)
		(center)
		(right)
	)
)

(defwidget center [](box))

(defwidget right []
	(box :class "right" :orientation "h" :space-evenly false :halign "end"

		(button :class "wifi" 
			:onclick "/home/nikotine/a" 
			wifi_icon
		)

		(button :class "battery" battery_level)
		
		(button :class "mute" 
			:onclick "wpctl set-mute @DEFAULT_SINK@ toggle" 
			mute_icon
		)

		(sound_bar 
			:label ""
			:volume volume
			:onchange "wpctl set-volume @DEFAULT_SINK@ {}"
		)

		(label :class "time" :text time)
	)
)

(defwidget left []
	(box :class "left" :orientation "h" :space-evenly false :halign "start"
		(literal :content workspace)
	)
)

(defwidget sound_bar [label volume onchange]
	(box :orientation "h"
		:class "sound_bar"
		:space-evenly false
		(scale 
			:min 0
			:max 2
			:round-digits 2
			:active {onchange != ""}
			:value volume
			:onchange onchange
		)
	)
)

(deflisten workspace "scripts/workspaces_listener.sh")

(deflisten mute_icon "scripts/mute_listener.sh")

(deflisten volume "scripts/volume_listener.sh")

(defpoll time :interval "1s"
	"date '+%H:%M:%S %b %d, %Y'"
)

(defpoll battery_level :interval "1s"
	"scripts/getbattery.sh"
)

(defpoll wifi_icon :interval "1s"
	"scripts/getwifi.sh"
)

(defwindow bar
	:monitor 0
	:windowtype "dock"
	:geometry (
		geometry :x "0%"
		:y "0%"
		:width "90%"
		:height "40px"
		:anchor "top center"
	)
	:reserve (struts :side "top" :distance "4%")
	:exclusive true
	:namespace "ewwbar"
	(bar)
)
